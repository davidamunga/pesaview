{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PesaView",
  "version": "0.2.1",
  "identifier": "com.amunga.david.pesaview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PesaView",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#efeee9",
        "width": 960,
        "height": 560,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://api.github.com https://github.com; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tabula-1.0.5-jar-with-dependencies.jar": "./",
      "resources/build-jre": "build-jre"
    },
    "publisher": "David Amunga",
    "category": "Utility",
    "shortDescription": "Extract tables from bank and M-PESA statement PDFs",
    "longDescription": "A desktop app that previews statement PDFs, lets you select or autodetect table regions, and exports the extracted data to CSV or Excel. Processing stays on your device.",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/davidamunga/pesaview/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCMDAwRkIyREFBRDgyMkMKUldRc2dxM2FzZzhBZXhoODhQYkhFYnFyaFJwcHYvbjNET0RKZE91Q05DcC9OMGxENGhqTmFqeEcK"
    }
  }
}
